[Unit]
Description=Roboreka VoIP-to-I2C Robot Arm Server (NanoPi NEO v1.4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roboreka
SupplementaryGroups=i2c
WorkingDirectory=/opt/roboreka
ExecStart=/opt/roboreka/.venv/bin/roboreka-server --config /etc/roboreka/config.toml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
