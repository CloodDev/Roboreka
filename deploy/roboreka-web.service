[Unit]
Description=Roboreka Web UI
After=network-online.target roboreka.service
Wants=network-online.target
Requires=roboreka.service

[Service]
Type=simple
User=roboreka-web
Group=roboreka-web
WorkingDirectory=/opt/roboreka
ExecStart=/opt/roboreka/.venv/bin/roboreka-web --api-url http://127.0.0.1:8081 --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
